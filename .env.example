# ========================
# Base de données (PostgreSQL)
# ========================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eglise_finance?schema=public"

# ========================
# NextAuth
# ========================
NEXTAUTH_SECRET="generer-avec-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ========================
# Provider de paiement (actif)
# ========================
# Valeurs possibles: mock, moneyfusion, stripe, cinetpay, paydunya
PAYMENT_PROVIDER="mock"

# ========================
# Money Fusion
# ========================
MONEY_FUSION_API_URL=""

# ========================
# Stripe
# ========================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ========================
# CinetPay
# ========================
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_PLATFORM=""

# ========================
# PayDunya
# ========================
PAYDUNYA_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_MASTER_KEY=""

# ========================
# Wave / Orange Money / MTN MoMo
# ========================
WAVE_API_KEY=""
ORANGE_MONEY_API_KEY=""
MTN_MOMO_API_KEY=""

# ========================
# Emails (Resend)
# ========================
RESEND_API_KEY=""
EMAIL_FROM="eglise@example.com"

# ========================
# App
# ========================
APP_URL="http://localhost:3000"
APP_NAME="Église Finance"
