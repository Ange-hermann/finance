generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================
// ENUMS
// ========================

enum Role {
  COLLECTOR
  TREASURER
  PASTOR
  AUDITOR
  ADMIN
}

enum CategorieTransaction {
  OFFRANDE
  DIME
  CONSTRUCTION
  DON_SPECIAL
  PROJET
  AUTRE
}

enum ModeTransaction {
  EN_LIGNE
  MANUEL
}

enum StatutTransaction {
  EN_ATTENTE
  VALIDE
  ANNULE
}

enum ModePaiementPhysique {
  ESPECES
  CHEQUE
}

enum ModePaiementSortant {
  MANUEL
  GENIUS_PAY
}

enum TypeDepense {
  DEPENSE_CULTE
  DEPENSE_NORMALE
}

enum CategorieDepense {
  MUSICIEN
  TRANSPORT
  MATERIEL
  ENTRETIEN
  FACTURE
  SALAIRE
  AUTRE
}

enum StatutDepense {
  EN_ATTENTE
  VALIDE
  ANNULE
}

enum SourceFonds {
  CAISSE
  ECONOMIE
  EPARGNE
  CONSTRUCTION
  ACTION_SOCIALE
}

// ========================
// MODÈLES
// ========================

model User {
  id              String        @id @default(cuid())
  nom             String
  email           String        @unique
  telephone       String?
  role            Role          @default(COLLECTOR)
  motDePasseHash  String
  actif           Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions    Transaction[]
  annotations     AnnotationAudit[]
  logs            LogAudit[]
  depenses        Depense[]
  dimes           DimeMensuelle[]
  demandes        DemandeAutorisation[]
  approbations   DemandeAutorisation[] @relation("Approbateur")
  pushSubscriptions PushSubscription[]
  beneficiaires   Beneficiaire[]
}

model Contributeur {
  id        String        @id @default(cuid())
  nom       String?
  telephone String?
  email     String?
  createdAt DateTime      @default(now())

  transactions Transaction[]
}

model Transaction {
  id                 String              @id @default(cuid())
  montant            Decimal             @db.Decimal(12, 2)
  categorie          CategorieTransaction
  mode               ModeTransaction
  modePaiementPhysique ModePaiementPhysique?
  contributeurId     String?
  contributeur       Contributeur?       @relation(fields: [contributeurId], references: [id])
  agentId            String?
  agent              User?               @relation(fields: [agentId], references: [id])
  statut             StatutTransaction   @default(EN_ATTENTE)
  referencePaiement  String?
  lienId             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  repartition        Repartition?
  recu               Recu?
  annotations        AnnotationAudit[]
  depenses           Depense[]
}

model Repartition {
  id                 String   @id @default(cuid())
  transactionId      String   @unique
  transaction        Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  montantEconomie    Decimal  @db.Decimal(12, 2) @default(0)
  montantEpargne     Decimal  @db.Decimal(12, 2) @default(0)
  montantActionSociale Decimal @db.Decimal(12, 2) @default(0)
  montantDimeDeLaDime Decimal? @db.Decimal(12, 2)
  montantCaisse      Decimal  @db.Decimal(12, 2) @default(0)
  montantFondsDedie  Decimal  @db.Decimal(12, 2) @default(0)
  createdAt          DateTime @default(now())
}

model TauxRepartition {
  id             String   @id @default(cuid())
  categorie      CategorieTransaction
  nomPoste       String
  pourcentage    Decimal  @db.Decimal(5, 2)
  dateEffet      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([categorie, nomPoste, dateEffet])
}

model Caisse {
  id           String   @id @default(cuid())
  soldeActuel  Decimal  @db.Decimal(14, 2) @default(0)
  updatedAt    DateTime @updatedAt
}

model Recu {
  id            String    @id @default(cuid())
  transactionId String    @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  urlPdf        String?
  envoyeLe      DateTime?
  createdAt     DateTime  @default(now())
}

model AnnotationAudit {
  id            String      @id @default(cuid())
  auteurId      String
  auteur        User        @relation(fields: [auteurId], references: [id])
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  commentaire   String
  createdAt     DateTime    @default(now())
}

model LogAudit {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  cible     String
  details   String?
  createdAt DateTime @default(now())
}

model LienPaiement {
  id          String   @id @default(cuid())
  lienId      String   @unique
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Depense {
  id              String            @id @default(cuid())
  type            TypeDepense
  categorie       CategorieDepense
  sourceFonds     SourceFonds       @default(CAISSE)
  description     String
  montant         Decimal           @db.Decimal(12, 2)
  transactionId   String?
  transaction     Transaction?      @relation(fields: [transactionId], references: [id])
  agentId         String?
  agent           User?             @relation(fields: [agentId], references: [id])
  dateDepense     DateTime          @default(now())
  justificatif    String?
  statut          StatutDepense     @default(EN_ATTENTE)
  // Paiement sortant
  beneficiaireId  String?
  beneficiaire    Beneficiaire?     @relation(fields: [beneficiaireId], references: [id])
  modePaiement    String            // MANUEL, GENIUS_PAY
  lienPaiement    String?           // Lien Genius Pay généré
  statutPaiement  String?           // EN_ATTENTE, LIEN_GENERE, PAYE, ECHOUE
  datePaiement    DateTime?
  referencePaiement String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model DimeMensuelle {
  id              String   @id @default(cuid())
  mois             Int      
  annee            Int      
  montant          Decimal  @db.Decimal(12, 2)
  dateVersement    DateTime?
  statut           StatutDime @default(NON_VERSE)
  agentId          String?
  agent            User?    @relation(fields: [agentId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([mois, annee])
}

enum StatutDime {
  NON_VERSE
  VERSE
}

enum StatutAutorisation {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
}

model DemandeAutorisation {
  id              String              @id @default(cuid())
  demandeurId     String
  demandeur       User                @relation(fields: [demandeurId], references: [id])
  sourceFonds     SourceFonds
  typeAction      String              // "DEPENSE", "TRANSFERT", etc.
  montant         Decimal             @db.Decimal(12, 2)
  description     String
  motif           String              // Motif de la demande
  statut          StatutAutorisation @default(EN_ATTENTE)
  approbateurId   String?
  approbateur     User?               @relation("Approbateur", fields: [approbateurId], references: [id])
  commentaire    String?
  dateDemande     DateTime            @default(now())
  dateReponse     DateTime?
  depenseId       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model PermissionRole {
  id          String     @id @default(cuid())
  role        Role
  sourceFonds SourceFonds
  niveauAcces String     @default("RESTREINT") // Simplified to string
  montantMax  Decimal?   @db.Decimal(12, 2) // Montant maximum sans autorisation
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([role, sourceFonds])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  role      Role?
  subscription Json     // Stocke l'objet subscription complet (endpoint, keys)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Beneficiaire {
  id        String   @id @default(cuid())
  nom       String
  telephone  String
  email     String?
  modePaiement String   // WAVE, ORANGE_MOMO, MTN_MOMO, CARTE, ESPECES
  actif     Boolean  @default(true)
  createdBy String?
  creator   User?    @relation(fields: [createdBy], references: [id])
  depenses  Depense[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
